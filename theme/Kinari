# Kinari（生成り）— 長時間作業向けの明るいターミナルテーマ
#
# 設計の根拠
# - 明るい背景に暗い文字（ポジ表示）。黒背景は、コントラストが下がったときに
#   読む速さ・注視時間の個人差が大きい（齋藤 2021, 日本色彩学会誌 45(4)）。
# - コントラストは高くするが、上げすぎない。真っ白に真っ黒は強すぎて負担になる
#   （平松ほか 2002 FIT; 齋藤 2021 は白背景に #333333 を推奨）。
#   本文は 12.1:1、背景は真っ白ではない生成り色（L*≈95）。
# - 色味に頼らない。年齢が上がるほど見分けは明るさの差に頼るので、
#   見分けたい色同士（赤/緑、青/紫、黄土/朱）は明るさ（L*）もずらしてある。
#   1型・2型色覚を模擬した計算でも差が残るように調整。
# - 文字に使う色は、すべて背景に対して 4.4:1 以上。本文より強い色は作らない。
# - 赤・朱は目立つ（神作 1987, 日眼会誌 91）ので、エラー・注意・カーソルだけに使う。
#
# Claude Code では /theme →「Light mode (ANSI colors only)」と組み合わせる。
#   0 本文 · 8 薄い文字 · 9 Claude の朱 · 4 許可・候補の青 · 1/2 削除/追加・失敗/成功
#   3 警告 · 5 スキル · 6 計画モード · 7 自分の発言の背景 · 15 コマンド出力の背景

background = #f4f2ec
foreground = #2f2e2b
cursor-color = #b84711
cursor-text = #f4f2ec
selection-background = #d6dde8
selection-foreground = #2f2e2b

palette = 0=#2f2e2b
palette = 1=#bc3b28
palette = 2=#1d573a
palette = 3=#6d5400
palette = 4=#22508f
palette = 5=#a0478c
palette = 6=#1b6a73
palette = 7=#e5e2da
palette = 8=#696660
palette = 9=#b84711
palette = 10=#2d6a4a
palette = 11=#7e6200
palette = 12=#2f5fa3
palette = 13=#a5508f
palette = 14=#237580
palette = 15=#ebe8e1

# 前景と背景がほぼ同じ色になったとき（明るい灰色の文字など）に、最低限のコントラストを確保する
minimum-contrast = 3

# 行間を少し広げる（行間が詰まると読みにくい: 齋藤 2021）
adjust-cell-height = 15%
